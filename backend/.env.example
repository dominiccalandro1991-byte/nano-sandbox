# Copy to backend/.env (never commit .env)
# Supabase project ref: sujvxxrwjqsziswuazwm
# Verified working pooler (us-west-2). Replace [YOUR-PASSWORD].

NANO_SANDBOX_DATABASE_URL=postgresql+psycopg://postgres.sujvxxrwjqsziswuazwm:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# NOTE: db.<ref>.supabase.com / db.<ref>.supabase.co may not resolve for this project.
# Prefer the pooler URI from Supabase Dashboard → Database → Connection string (Session mode).

NANO_SANDBOX_KMS_SEED=replace-with-long-random-production-seed
NANO_SANDBOX_KMS_PROVIDER=software_tee

# OpenRouter (server-side only)
NANO_SANDBOX_OPENROUTER_API_KEY=
# OPENROUTER_API_KEY=

# CausalRail HTTP ingest only — NEVER a database URL. Empty disables.
# NANO_SANDBOX_CAUSALRAIL_INGEST_URL=https://causalrail-api.onrender.com/api/ingest
